# ---------------------------------------------------------------------------
# apex-trader environment template. Copy to .env and fill in. NEVER commit .env.
# Every value is optional for a paper (LIVE_TRADING=false) cycle, except that
# email + LLM notifications silently degrade when their keys are absent
# (fail-open by design: a missing LLM/email must never block a trade signal).
# ---------------------------------------------------------------------------

# --- Mode -------------------------------------------------------------------
# false = paper trading against live prices (default). true = real orders on
# Revolut X. In GitHub Actions this comes from the repo VARIABLE LIVE_TRADING.
LIVE_TRADING=false

# --- Revolut X (only needed when LIVE_TRADING=true) --------------------------
REVOLUT_X_API_KEY=
# Either a path to the Ed25519 private key PEM (local use)...
REVOLUT_X_PRIVATE_KEY_PATH=~/.config/revolut-x/private.pem
# ...or the raw PEM contents (CI secret use; takes precedence if set):
# REVOLUT_X_PRIVATE_KEY=

# --- LLM veto chain (optional; first reachable model wins) -------------------
GROQ_API_KEY=
OPENROUTER_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile   # override: remap every chain entry
# LLM_MAX_TOKENS=2000

# --- Email notifications (optional, Gmail SMTP SSL :465) ---------------------
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# NOTIFY_EMAIL=            # defaults to GMAIL_ADDRESS
# EMAIL_ON_TRADE=true
# EMAIL_ON_FAILURE=true
# EMAIL_DAILY_DIGEST=true
# EMAIL_ON_HOLD=false

# --- Trading config (defaults shown; see apex_trader.py header) --------------
# STARTING_CAPITAL_EUR=500
# SIZING_MODE=exposure
# ATR_STOP_MULT=6.0
# RISK_PER_TRADE_PCT=0.01   # only used when SIZING_MODE=risk
# CHECK_INTERVAL=900        # seconds between cycles in loop mode

# --- Runner control ----------------------------------------------------------
# RUN_ONCE=true             # single cycle then exit (CI / scheduled runner)
# DRY_RUN=true              # compute everything, place no orders at all
# STATE_FILE=apex_state.json
# LOG_FILE=apex_decisions.jsonl
